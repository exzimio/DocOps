# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# ---------------------------------------------------------------------------
# Local SQL Server container (docker compose)
# ---------------------------------------------------------------------------
# Password for the container's sa account. Development-only credential.
MSSQL_SA_PASSWORD=Local_Dev_Passw0rd!
# Host port for the container. 14330 avoids clashing with a SQL Server already on 1433.
MSSQL_HOST_PORT=14330

# ---------------------------------------------------------------------------
# API configuration (read as ASP.NET Core configuration via double underscores)
# ---------------------------------------------------------------------------
ConnectionStrings__DocOpsDatabase=Server=127.0.0.1,14330;Database=DocOpsControlTower;User Id=sa;Password=Local_Dev_Passw0rd!;TrustServerCertificate=True;MultipleActiveResultSets=True;Encrypt=True

# Origins allowed to call the API with credentials (the Vite dev server by default).
Cors__AllowedOrigins__0=http://localhost:5173

# Demo data: applies migrations and seeds organisations/users on start-up.
Seed__ApplyMigrations=true
Seed__Enabled=true
Seed__DefaultPassword=Demo!Pass123

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# OTLP endpoint for traces and metrics. Leave empty to keep telemetry in-process.
OpenTelemetry__OtlpEndpoint=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Target the Vite dev server proxies /api to.
VITE_API_PROXY_TARGET=http://localhost:5180
