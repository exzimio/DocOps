# Copy to .env and change the values. .env is ignored by Git; never commit it.
#
# One file for everything local: Docker Compose reads it for the SQL Server container, the scripts in
# scripts/ read the passwords from it, and in Development the API and the worker read it as their
# configuration. Real environment variables always win over this file.
#
# A value may refer to one defined above it with ${NAME}, which is how the connection strings below
# use the passwords without repeating them.

# ---------------------------------------------------------------------------
# SQL Server container
# ---------------------------------------------------------------------------
# Administrator password of the local container. Only used to create the database and the three
# identities below; the application never connects as the administrator.
MSSQL_SA_PASSWORD=Example_Admin_2026!
# Host port. 14330 avoids clashing with a SQL Server already listening on 1433.
MSSQL_HOST_PORT=14330

# ---------------------------------------------------------------------------
# The three database identities (created by scripts/create-database-identities.sql)
# ---------------------------------------------------------------------------
# SQL Server refuses a password that contains a part of the account name ("app", "tenant",
# "system", "docops", "migrator"), and the refusal looks like a syntax error. Keep that in mind when
# choosing new ones.
DOCOPS_TENANT_PASSWORD=Example_Requests_2026!
DOCOPS_SYSTEM_PASSWORD=Example_Background_2026!
DOCOPS_MIGRATOR_PASSWORD=Example_Schema_2026!

# ---------------------------------------------------------------------------
# API and worker connection strings (ASP.NET Core configuration, double underscores for sections)
# ---------------------------------------------------------------------------
# app_tenant serves ordinary requests.
ConnectionStrings__DocOpsDatabase=Server=127.0.0.1,${MSSQL_HOST_PORT};Database=DocOpsControlTower;User Id=app_tenant;Password=${DOCOPS_TENANT_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=True;Encrypt=True
# app_system is the identity the row-level security policy accepts for system work (sign-in, the
# worker, seeding). Required: without it the application refuses to start.
ConnectionStrings__DocOpsSystem=Server=127.0.0.1,${MSSQL_HOST_PORT};Database=DocOpsControlTower;User Id=app_system;Password=${DOCOPS_SYSTEM_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=True;Encrypt=True
# docops_migrator is the only identity that can change the schema. Only the migration step uses it.
ConnectionStrings__DocOpsMigrator=Server=127.0.0.1,${MSSQL_HOST_PORT};Database=DocOpsControlTower;User Id=docops_migrator;Password=${DOCOPS_MIGRATOR_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=True;Encrypt=True

# Origins allowed to call the API with credentials (the Vite dev server by default).
Cors__AllowedOrigins__0=http://localhost:5173

# Demo data: applies migrations and seeds organisations and users on start-up. The demo accounts all
# use this password, which the sign-in screen shows on purpose: they are fictional and local.
Seed__ApplyMigrations=true
Seed__Enabled=true
Seed__DefaultPassword=Demo!Pass123

# ---------------------------------------------------------------------------
# Full stack in containers (docker-compose.full.yml)
# ---------------------------------------------------------------------------
# The stack builds its own connection strings from the passwords above, pointing at the container
# network. These two only change where it is published.
# DOCOPS_PUBLIC_PORT=8080
# DOCOPS_PUBLIC_ORIGIN=http://localhost:8080

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# OTLP endpoint for traces and metrics. Leave empty to keep telemetry in-process.
OpenTelemetry__OtlpEndpoint=

# ---------------------------------------------------------------------------
# Document intelligence (optional)
# ---------------------------------------------------------------------------
# "Demo" (default) runs the deterministic, rule-based provider: no account, no cost, and every
# screen says it is a demonstration. "OpenAiCompatible" calls a language model instead.
Ai__Provider=Demo
# For OpenAI:        Ai__Endpoint=https://api.openai.com/v1
# For Azure OpenAI:  Ai__Endpoint=https://<resource>.openai.azure.com/openai/deployments/<deployment>
# Ai__Endpoint=
# Ai__Model=
# The key is read from the environment only. Never put it in appsettings.json or commit it.
# Ai__ApiKey=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Target the Vite dev server proxies /api to.
VITE_API_PROXY_TARGET=http://localhost:5180
