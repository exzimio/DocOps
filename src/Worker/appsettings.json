{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DocOpsDatabase": "",
    "DocOpsSystem": ""
  },
  "BackgroundJobs": {
    "IntervalSeconds": 60,
    "EscalateOverdueTasks": true,
    "ResumeWorkflowTimers": true
  },
  "FileStorage": {
    "RootPath": "storage"
  },
  "Seed": {
    "Enabled": false,
    "ApplyMigrations": false
  }
}
