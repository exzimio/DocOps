<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Application\DocOps.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- SignInManager, IHttpContextAccessor and the cookie handler live in the shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The intake documents the demo seeds, from the same files a person can upload by hand. -->
    <EmbeddedResource Include="..\..\samples\*.txt" LogicalName="DocOps.Samples.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The value parsers are implementation details of the demo provider, but worth testing on their own. -->
    <InternalsVisibleTo Include="DocOps.UnitTests" />
  </ItemGroup>


  <!--
    O analisador viaja como analisador, e não como dependência: o código compilado não o
    referencia, só o compilador o carrega. É por isso que a violação passa a ser um erro de
    compilação a sério, e aparece sublinhada no editor enquanto se escreve.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Analyzers\DocOps.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
